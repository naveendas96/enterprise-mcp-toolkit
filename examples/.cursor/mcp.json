{
  "mcpServers": {
    "itsm-readwrite": {
      "command": "python",
      "args": ["-m", "emcp.itsm"],
      "env": { "MCP_SCOPES": "itsm:read,itsm:write", "MCP_ACTOR": "cursor-agent" }
    },
    "data": { "command": "python", "args": ["-m", "emcp.data"], "env": { "MCP_SCOPES": "data:read" } },
    "refund": { "command": "python", "args": ["-m", "emcp.refund"], "env": { "MCP_SCOPES": "refund:write", "MCP_ACTOR": "cursor-agent" } }
  }
}
